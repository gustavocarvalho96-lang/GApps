{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "gapps-suporte",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [{ "name": "ACCESS_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "gapps-suporte", "database_id": "40068b6b-134d-4367-a429-b7e835f66f5d" }]
}
